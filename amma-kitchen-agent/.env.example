RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Buyer agent scripts call Claude via OpenRouter (see llm_client.py) --
# get a free key at openrouter.ai (new accounts get $1 free credit).
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: real SMS/WhatsApp escalation. Without these, alerts go to an
# in-memory outbox shown in the merchant console -- the loop is fully
# demoable offline. Set SMS_ENABLED=false to force the mock even with
# credentials present.
TWILIO_ACCOUNT_SID=
# Also verifies INBOUND replies. /webhook/sms-reply approves merchant orders,
# so it is signature-checked like the Razorpay webhook. Unset means Twilio
# replies are REJECTED, never waved through.
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
MERCHANT_PHONE=
SMS_ENABLED=true

# The credential the consoles' own reply boxes present to
# /webhook/sms-reply. They are not Twilio-signed -- deliberately, because the
# mock path has to exercise the real handler -- so they carry this instead.
# Leave it blank and the server generates one per process and stamps it into
# the console pages; set it to pin it across restarts.
INTERNAL_REPLY_TOKEN=

# The merchant console's password. Everything that writes -- her limits,
# her menu, repricing, and approving an order -- is behind this. Without it
# set, those surfaces cannot be logged into at all, which is the safe
# default rather than the convenient one.
MERCHANT_CONSOLE_PASSWORD=

# Signs the merchant's session cookie. Leave blank and the server uses a
# per-process random key, so logins simply do not survive a restart; set it
# to keep them. Never a value from this file -- generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# The background clock: refunds a paid order the merchant never answered,
# and places standing orders when their occurrence comes round. Both were
# complete and tested long before anything called them.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60
# How long a paid order waits for her before the money goes back.
MERCHANT_TIMEOUT_MINUTES=45

# Hosts the MCP endpoint will accept (comma-separated). Your ngrok or
# deploy domain must be listed, or the SDK rejects it with 421 "Invalid
# Host header". Unset means localhost only.
MCP_ALLOWED_HOSTS=

# Optional. The card-S2S settlement fallback needs a card; none is stored
# in the repo, so that path is simply skipped unless you set one here.
# Format: number:MM:YYYY:cvv  (test cards only)
RAZORPAY_S2S_TEST_CARD=

# ---------------------------------------------------------------- Google
# Optional. Both consoles work fully without it -- the merchant has her
# password, the customer has the form -- and the sign-in buttons simply do
# not appear when this is blank.
#
# To set it up: console.cloud.google.com -> APIs & Services -> Credentials
# -> Create credentials -> OAuth client ID -> Web application. Add your
# origin (http://localhost:8000) under "Authorised JavaScript origins".
# No redirect URI is needed: this verifies an ID token rather than
# exchanging a code, so there is no client secret here either.
GOOGLE_CLIENT_ID=

# WHO MAY RUN THE KITCHEN, comma-separated. Required for merchant Google
# sign-in and deliberately has no default: without a list, "sign in with
# Google" would let ANY Google account on earth open her shop, which is
# strictly worse than the password. Unset means the button stays hidden
# and the password remains the only door.
MERCHANT_GOOGLE_EMAILS=
